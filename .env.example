# Copy to .env and fill in. NEVER commit .env.
MISTRAL_API_KEY=your-mistral-key-here

# Optional tuning
MISTRAL_MODEL=ministral-3b-latest
LLM_CONCURRENCY=10
LLM_BATCH_SIZE=10
LLM_TIMEOUT_SECONDS=15.0
MAX_RECORDS=500

# Production knobs
RATE_LIMIT_PER_MINUTE=30
LOG_MESSAGE_TEXT=false
HOST=127.0.0.1
PORT=8000
